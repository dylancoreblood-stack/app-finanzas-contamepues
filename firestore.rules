rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla de Oro de Seguridad Financiera:
    // Un usuario autenticado SOLO puede leer, crear, actualizar y borrar SUS PROPIOS datos.
    // Nadie más puede acceder ni ver presupuestos, deudas o balances ajenos.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
